    // A platform's icon, by the `icon` name in library/platforms.toml (platformIconNames
    // below lists them). Unknown or empty names get the generic library icon.
    // The names forPlatform() knows, for the icon picker; "" is the generic icon.
    readonly property var platformIconNames: ["switch", "3ds", "wiiu", "wii", "gamecube", "n64", "nds", "gba", "psp", "ps1", "ps2", "ps3", "ps4", "steam", "proton", "linux", "gamepad", ""]

    function forPlatform(icon: string): string {
        switch (icon) {
        case "switch": return switchConsole
        case "3ds": return nintendo3ds
        case "wiiu": return wiiu || library
        case "wii": return wii || library
        case "gamecube": return gamecube || library
        case "n64": return n64
        case "nds": return nds
        case "gba": return gba
        case "psp": return psp
        case "ps1": return ps1
        case "ps2": return ps2
        case "ps3": return ps3
        case "ps4": return ps4
        case "steam": return steam
        case "proton": return goblet
        case "linux": return penguin || library
        case "gamepad": return gamepad
        }
        return library
    }

    // What the icon picker calls a platform icon.
    function platformIconLabel(icon: string): string {
        switch (icon) {
        case "switch": return qsTr("Switch")
        case "3ds": return qsTr("3DS")
        case "wiiu": return qsTr("Wii U")
        case "wii": return qsTr("Wii")
        case "gamecube": return qsTr("GameCube")
        case "n64": return qsTr("Nintendo 64")
        case "nds": return qsTr("Nintendo DS")
        case "gba": return qsTr("Game Boy Advance")
        case "psp": return qsTr("PSP")
        case "ps1": return qsTr("PlayStation")
        case "ps2": return qsTr("PlayStation 2")
        case "ps3": return qsTr("PlayStation 3")
        case "ps4": return qsTr("PlayStation 4")
        case "steam": return qsTr("Steam")
        case "proton": return qsTr("Proton")
        case "linux": return qsTr("Linux")
        case "gamepad": return qsTr("Gamepad")
        }
        return qsTr("Generic")
    }
}
